# 既定ではテキストとして扱い、リポジトリには LF で格納する
* text=auto eol=lf

# メモ帳で開かれる前提のファイルは、取り出すときに CRLF にする
# （配布 zip の中身は packaging\build-release.ps1 が改行を揃え直すので、
#   ここでの指定はリポジトリを clone した人の見え方のためのもの）
*.txt   text eol=crlf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# バイナリ（改行変換をさせない）
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.zip   binary
*.exe   binary

# GitHub の「Source code (zip)」に入れないもの
.gitattributes      export-ignore
.gitignore          export-ignore
.github/            export-ignore
